#!/usr/bin/env python3
"""ice - command-line client for the Thin Ice game server."""
import json
import os
import sys
import urllib.error
import urllib.request

URL = os.environ.get("THINICE_URL", "http://game:8000").rstrip("/")

USAGE = """\
usage: ice <command> [--json]

  ice rules               print the rules
  ice list                all scored puzzles and the score so far
  ice show P01            board, stones and legal moves of a puzzle
  ice move P01 a1-a5      play a Blue move (from-to); Red replies at once; no undo
  ice practice 3          start a practice puzzle with a forced win in 3 moves (never scored)
  ice api                 describe the HTTP API, for use from your own scripts

Add --json to get the raw JSON reply instead of text.
"""

API = f"""\
HTTP API at {URL} (JSON in, JSON out; errors come back with "ok": false and an "error" text)

  GET  /api/rules
  GET  /api/puzzles                 -> solved, total, score, puzzles[id, win_in, status, moves_used, moves_allowed]
  GET  /api/puzzle/<id>             -> status, win_in, moves_used, moves_allowed, board (text),
                                       blue[], red[] (cell names), legal_moves[], history[]
  POST /api/move      {{"id": "P01", "move": "a1-a5"}}
                                    -> played, reply (Red's move or null), status, reason, puzzle{{...}}
  POST /api/practice  {{"win_in": 3}}  -> a new practice puzzle, same shape as /api/puzzle

Cells are a1..e5: column letter a-e, then row 1-5, a1 bottom-left.
"""


def call(method: str, path: str, body=None) -> dict:
    data = None if body is None else json.dumps(body).encode()
    req = urllib.request.Request(URL + path, data=data, method=method, headers={"Content-Type": "application/json"})
    try:
        with urllib.request.urlopen(req, timeout=30) as resp:
            return json.loads(resp.read())
    except urllib.error.HTTPError as exc:
        try:
            return json.loads(exc.read())
        except Exception:
            return {"ok": False, "error": f"HTTP {exc.code}"}
    except OSError as exc:
        return {"ok": False, "error": f"cannot reach the game server at {URL}: {exc}"}


def puzzle_text(p: dict) -> str:
    kind = "Practice puzzle" if p.get("practice") else "Puzzle"
    lines = [
        f"{kind} {p['id']}: Blue has a forced win in {p['win_in']} move(s). Moves used: {p['moves_used']} of {p['moves_allowed']} allowed.",
        p["board"],
        f"Blue stones: {' '.join(p['blue'])}   Red stones: {' '.join(p['red'])}",
    ]
    if p["status"] == "open":
        lines.append("Blue (you) to move. Legal moves: " + " ".join(p["legal_moves"]))
    else:
        lines.append(f"Status: {p['status'].upper()}" + (f" ({p['reason']})" if p.get("reason") else ""))
    return "\n".join(lines)


def main() -> int:
    args = [a for a in sys.argv[1:] if a != "--json"]
    as_json = "--json" in sys.argv[1:]
    if not args or args[0] in ("-h", "--help", "help"):
        print(USAGE)
        return 0
    cmd = args[0]
    if cmd == "api":
        print(API)
        return 0
    if cmd == "rules":
        r = call("GET", "/api/rules")
        text = r.get("rules", "")
    elif cmd == "list":
        r = call("GET", "/api/puzzles")
        if r.get("ok"):
            rows = ["id   win-in  status  moves"]
            rows += [f"{p['id']:<4} {p['win_in']:<7} {p['status']:<7} {p['moves_used']}/{p['moves_allowed']}" for p in r["puzzles"]]
            rows.append(f"Solved {r['solved']} of {r['total']}. Score: {r['score']:.3f}")
            text = "\n".join(rows)
    elif cmd == "show" and len(args) == 2:
        r = call("GET", f"/api/puzzle/{args[1]}")
        if r.get("ok"):
            text = puzzle_text(r)
    elif cmd == "move" and len(args) == 3:
        r = call("POST", "/api/move", {"id": args[1], "move": args[2]})
        if r.get("ok"):
            p = r["puzzle"]
            if r["status"] == "solved":
                text = f"You played {r['played']}: three in a row. {p['id']} SOLVED."
            elif r["status"] == "failed":
                reply = f" Red replied {r['reply']}." if r.get("reply") else ""
                text = f"You played {r['played']}.{reply} {p['id']} FAILED: {r['reason']}."
            else:
                text = f"You played {r['played']}. Red replied {r['reply']}.\n{puzzle_text(p)}"
            if r.get("feedback"):
                text += "\n" + r["feedback"]
    elif cmd == "practice" and len(args) == 2:
        r = call("POST", "/api/practice", {"win_in": args[1]})
        if r.get("ok"):
            text = puzzle_text(r)
    else:
        print(USAGE, file=sys.stderr)
        return 2
    if as_json:
        print(json.dumps(r, indent=2))
        return 0 if r.get("ok") else 1
    if not r.get("ok"):
        print(f"ERROR: {r.get('error', 'unknown error')}", file=sys.stderr)
        return 1
    print(text)
    return 0


if __name__ == "__main__":
    sys.exit(main())
